# Copy this file to .env.local and fill in your Firebase project values
# Keep this file out of source control; do NOT commit real secrets.

REACT_APP_APIKEY=yourApiKeyHere
REACT_APP_AUTHDOMAIN=your-project.firebaseapp.com
REACT_APP_DB=https://your-project.firebaseio.com
REACT_APP_PID=your-project-id
REACT_APP_SB=your-project.appspot.com
REACT_APP_SID=your-messaging-sender-id
REACT_APP_APPID=your-app-id
REACT_APP_MID=your-measurement-id
